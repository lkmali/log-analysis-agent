{
  "name": "loger-agents",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:setup": "db/migrations/run-migrations.sh",
    "db:migrate": "tsx --env-file=.env backend/db/migrate.ts",
    "db:test": "backend/db/run-tests.sh",
    "settings:import": "tsx --env-file=.env backend/settings/import-env.ts",
    "db:reset": "db/reset-data.sh",
    "user:create": "tsx --env-file=.env backend/db/create-user.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.700.0",
    "@aws-sdk/credential-providers": "^3.700.0",
    "bcryptjs": "^2.4.3",
    "next": "^15.1.0",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
