# Only database settings and process switches live in .env.
# The web app, API, scheduler, AI agents and migrations all use this ONE database.
# Everything else (polling, alerts, AWS, AI keys and agents) is configured in the
# dashboard: Settings page (superadmin can edit, everyone else can view).
# Copy to .env and edit:  cp .env.example .env

# Owner role: owns all objects; migrations, scheduler and AI agents connect as this user.
SQL_HOST=localhost
SQL_PORT=5432
SQL_DATABASE=sre
SQL_USER=sre_owner
SQL_PASSWORD=owner-pass
# Optional: e.g. require (for RDS / remote databases)
SQL_SSLMODE=

# Admin / superuser used ONLY by `npm run db:setup` to create the owner role + database.
# Leave empty to reuse SQL_USER / SQL_PASSWORD (when the DB already exists).
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=
SQL_ADMIN_DATABASE=postgres

# Process-level switches
SESSION_TTL_SECONDS=604800
# "false" disables public sign-up once your accounts exist. (The first account becomes superadmin.)
# "false" runs the dashboard without background jobs.
SCHEDULER_ENABLED=true
